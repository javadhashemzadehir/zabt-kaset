{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zabet Kaset",
  "version": "0.1.0",
  "identifier": "app.zabetkaset.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @zabet-kaset/desktop dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @zabet-kaset/desktop build",
    "frontendDist": "../apps/desktop/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Zabet Kaset",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Media downloader and organizer",
    "longDescription": "Professional YouTube and media download manager with queue, history, subtitles, and smart organization.",
    "category": "Utility",
    "windows": {
      "digestAlgorithm": "sha256"
    }
  },
  "plugins": {}
}
