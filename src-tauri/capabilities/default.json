{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Zabet Kaset",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "fs:allow-read-dir",
    "fs:allow-exists"
  ]
}
