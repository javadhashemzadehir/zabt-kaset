{
  "name": "zabt-kaset",
  "version": "0.1.0",
  "private": true,
  "description": "Professional desktop media downloader and organizer for YouTube and beyond",
  "license": "MIT",
  "author": "Zabt Kaset Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/javadhashemzadehir/zabt-kaset.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @zabt-kaset/desktop dev",
    "build": "pnpm --filter @zabt-kaset/desktop build",
    "lint": "pnpm --filter @zabt-kaset/desktop lint",
    "typecheck": "pnpm --filter @zabt-kaset/desktop typecheck",
    "test": "pnpm --filter @zabt-kaset/desktop test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "prepare:tools": "node scripts/prepare-tools.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.2"
  }
}
